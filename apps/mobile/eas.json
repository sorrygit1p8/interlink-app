{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": false, "distribution": "internal", "env": { "EXPO_PUBLIC_APP_ENV": "development", "EXPO_PUBLIC_DATA_MODE": "demo" }, "android": { "buildType": "apk" }, "ios": { "simulator": true } },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_DATA_MODE": "demo" }, "android": { "buildType": "apk" } },
    "staging": { "distribution": "internal", "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_DATA_MODE": "supabase" }, "android": { "buildType": "apk" } },
    "production": { "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_DATA_MODE": "supabase" }, "android": { "buildType": "app-bundle" } }
  }
}
