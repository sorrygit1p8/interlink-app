# Mode and deployment stage are independent. No remote service is used in demo.
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_APP_ENV=development
INTERLINK_DATA_MODE=demo
INTERLINK_APP_ENV=development

# Public mobile Supabase endpoint / publishable or anon key; never service-role keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web server uses the public key with the caller's verified user session.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional existing EAS project. Local demo does not require one.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Supply owned production identifiers before release; demo config has explicit placeholders.
INTERLINK_ANDROID_PACKAGE=
INTERLINK_IOS_BUNDLE_ID=

# Unresolved operating details: production validation requires these and a separate review.
# It also checks the actual rendered drafts in apps/web/content/policies.ts.
# Filling these declarations cannot resolve [미확정] operator/contact/retention/
# processor/transfer/age/consent information still present in those documents.
INTERLINK_OPERATOR_NAME=
INTERLINK_SUPPORT_EMAIL=
INTERLINK_PRIVACY_URL=
INTERLINK_TERMS_URL=
INTERLINK_RETENTION_POLICY=
INTERLINK_LAUNCH_REVIEW_APPROVED=false

# Edge/server ONLY, provision securely when integrating. Never public-prefix these names.
# Preflight: npm run check:config -- --target=edge --mode=supabase --environment=staging
# This target reads SUPABASE_* directly; EXPO_PUBLIC_* cannot replace server values.
SUPABASE_SERVICE_ROLE_KEY=
# Independent 32–512 character secret without whitespace; not a client/public key.
INTERLINK_WORKER_SECRET=
# Comma-separated exact origins permitted to call image-upload from a browser.
# No wildcard, credentials, path, trailing slash, query or fragment.
# HTTPS required except explicit local HTTP origins before production.
EDGE_ALLOWED_ORIGINS=
# Optional Expo enhanced push security token; Edge worker only.
EXPO_ACCESS_TOKEN=
